# ---------- Auth ----------
# Two-user admin gate. Comma-separated `username:base64-hash` pairs.
# Generate the base64 value with: pnpm hash-password <password>
# The hash is base64-encoded to sidestep dotenv's `$VAR` interpolation,
# so no quoting or escaping is needed here.
ALLOW_USERS=alejandro:REPLACE_WITH_OUTPUT_OF_PNPM_HASH_PASSWORD

# 32+ random bytes, base64. Used to sign the session JWT.
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-base64-of-32-bytes-or-more

# Fixes Server Action encryption key across builds. Without it Next mints a
# fresh key every `next build`, so each redeploy breaks already-open browsers
# with "Failed to find Server Action". Must be base64 of 16/24/32 bytes.
# Generate with: openssl rand -base64 32
# NOTE: consumed at BUILD time (docker-compose build arg), not just runtime.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-base64-of-32-bytes

# ---------- Database ----------
DATABASE_URL=postgres://retrospectiva:retrospectiva@localhost:5432/retrospectiva
# Optional — tune the postgres-js pool size. Default 10.
DATABASE_POOL_MAX=10

# ---------- Redis (BullMQ) ----------
REDIS_URL=redis://localhost:6379

# ---------- OpenAI ----------
OPENAI_API_KEY=
# Text model used for descriptions / era estimation.
# gpt-4.1-mini: vision + structured-output capable, non-reasoning (no
# hidden reasoning-token budget trap). Avoid gpt-5-nano here — too weak
# for the ES copy + strict schema; it hits `incomplete: max_output_tokens`.
OPENAI_TEXT_MODEL=gpt-4.1-mini
# Image model used for placing the garment on the brand's model.
OPENAI_IMAGE_MODEL=gpt-image-2
# Text model used for translations
OPENAI_TRANSLATE_MODEL=gpt-4o-mini
# Optional override for the brand-voice prompt; if unset, the bundled
# prompt in src/lib/integrations/openai/prompts.ts is used.
BRAND_VOICE_PROMPT=

# ---------- Etsy (Open API v3, OAuth 2.0) ----------
# Register the app at https://www.etsy.com/developers and use this redirect URI.
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=https://admin.retrospectiva.example/api/etsy/oauth/callback
ETSY_SHOP_ID=
# Shared HMAC secret for the (optional) Etsy webhook beta. Polling is the
# default sold-detection path, see Phase 7.
ETSY_WEBHOOK_SECRET=

# ---------- Cloudflare R2 ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=retrospectiva
# Public base URL — custom domain bound to the R2 bucket. No trailing slash.
R2_PUBLIC_BASE_URL=https://cdn.retrospectiva.example

# ---------- Retrospectiva website (revalidation webhook) ----------
# The public site we POST to whenever a product is published, updated, or sold.
WEBSITE_WEBHOOK_URL=https://retrospectiva.store/api/webhooks/products
WEBSITE_WEBHOOK_SECRET=replace-with-shared-secret
# Bearer token the website passes to read the public product API
# (GET /api/public/products). Same value must be set on the website.
PUBLIC_API_TOKEN=replace-with-shared-read-token

# ---------- Optional ----------
# Telegram bot for sale + AI-failure notifications. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# When truthy (1 / true / yes / on), the per-product image-placement
# worker prints the fully assembled prompt to stdout right before the
# OpenAI call. Useful for verifying the new-product form's selects
# map to the expected prompt blocks. Off by default — the prompt is
# large and would otherwise noise up the worker logs.
LOG_IMAGE_PLACEMENT_PROMPT=
