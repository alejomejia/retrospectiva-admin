{
  "name": "retrospectiva-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-ffmpeg-core.mjs",
    "dev": "next dev",
    "build": "node scripts/copy-ffmpeg-core.mjs && next build",
    "postinstall": "node scripts/copy-ffmpeg-core.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "compose": "docker compose up postgres redis",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "worker": "NODE_OPTIONS=--conditions=react-server tsx watch src/lib/queue/worker.ts",
    "worker:prod": "NODE_OPTIONS=--conditions=react-server tsx src/lib/queue/worker.ts",
    "worker:log": "LOG_IMAGE_PLACEMENT_PROMPT=1 NODE_OPTIONS=--conditions=react-server tsx watch src/lib/queue/worker.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "etsy:taxonomy": "tsx scripts/fetch-etsy-taxonomy.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1045.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@hookform/resolvers": "5.2.2",
    "@tanstack/react-table": "8.21.3",
    "bcryptjs": "3.0.3",
    "browser-image-compression": "2.0.2",
    "bullmq": "5.76.7",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "heic2any": "0.0.4",
    "ioredis": "5.10.1",
    "jose": "6.2.3",
    "lucide-react": "1.14.0",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "openai": "6.37.0",
    "postgres": "3.4.9",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-day-picker": "10.0.0",
    "react-dom": "19.2.4",
    "react-hook-form": "7.75.0",
